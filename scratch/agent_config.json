{
  "name": "Ops Dining — AI Agent Pro (Live)",
  "nodes": [
    {
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-agent-v3"
      }
    },
    {
      "id": "agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [250, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.data.message?.conversation || $json.body.data.message?.extendedTextMessage?.text || 'Hola' }}",
        "options": {
          "systemMessage": "Eres la Recepcionista de Ops Dining. Hoy es 6 Mayo 2026. Gestiona reservas. Usa tus herramientas."
        }
      }
    },
    {
      "id": "model",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [150, 200],
      "credentials": {
        "openAiApi": {
          "id": "7Yexka0KGrdxkO2D"
        }
      },
      "parameters": {
        "model": "gpt-4o-mini"
      }
    },
    {
      "id": "memory",
      "name": "Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryWindowBuffer",
      "typeVersion": 1.3,
      "position": [350, 200],
      "parameters": {
        "sessionId": "={{ $node[\"Webhook\"].json.body.data.key.remoteJid }}"
      }
    },
    {
      "id": "whatsapp",
      "name": "WhatsApp",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [550, 200],
      "parameters": {
        "description": "Envía WhatsApp. Params: text, number.",
        "method": "POST",
        "url": "http://178.104.234.176:8082/message/sendText/OpsDiningPro",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "OpsDining2026"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"number\": \"{{ $node[\\\"Webhook\\\"].json.body.data.key.remoteJid }}\", \"text\": \"{{ $fromAI }}\"}"
      }
    }
  ],
  "connections": {
    "webhook": {
      "main": [
        [
          {
            "node": "agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "model": {
      "ai_languageModel": [
        [
          {
            "node": "agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "memory": {
      "ai_memory": [
        [
          {
            "node": "agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "whatsapp": {
      "ai_tool": [
        [
          {
            "node": "agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  }
}
